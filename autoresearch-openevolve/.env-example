# Copy to autoresearch-openevolve/.env. Existing environment variables take precedence.
# OpenAI-compatible API base URL (include /v1, omit /chat/completions).
# SAIL:       https://api.sailresearch.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# VibeProxy:  http://localhost:8317/v1 (run VibeProxy and authenticate first)
OPENAI_BASE_URL=http://localhost:8317/v1
# VibeProxy accepts a placeholder unless you configured proxy authentication.
OPENAI_API_KEY=not-needed
# Use the exact model ID exposed by your provider's /models endpoint.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=xhigh
# Fast mode; the provider/proxy must support priority processing.
OPENAI_SERVICE_TIER=priority
ITERATIONS=50
# Leave blank to use the provider's default output limit; context limits are unchanged.
MAX_TOKENS=
API_TIMEOUT=180
