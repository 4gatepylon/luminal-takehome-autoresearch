================ PROGRAM ================
s0 = buff[scores][0]
t0 = buff[thresholds][0]
s1 = buff[scores][1]
t1 = buff[thresholds][1]
s2 = buff[scores][2]
t2 = buff[thresholds][2]
s3 = buff[scores][3]
t3 = buff[thresholds][3]
c0 = s0 < t0
c1 = s1 < t1
c2 = s2 < t2
c3 = s3 < t3
m0 = t0 if { c0 } else s0
m1 = t1 if { c1 } else s1
m2 = t2 if { c2 } else s2
m3 = t3 if { c3 } else s3
buff[out][0] = m0
buff[out][1] = m1
buff[out][2] = m2
buff[out][3] = m3

